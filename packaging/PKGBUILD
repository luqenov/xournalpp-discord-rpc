# Maintainer: luqenov <https://codeberg.org/luqenov>
pkgname=xournal-rpc
pkgver=0.2.0
pkgrel=1
pkgdesc="Discord Rich Presence for Xournal++ on Linux"
arch=('x86_64' 'aarch64')
url="https://codeberg.org/luqenov/xournalpp-discord-rpc"
license=('MIT')
depends=('glibc')
makedepends=('cargo' 'rust' 'git')
install="$pkgname.install"
source=("git+$url.git#tag=v$pkgver"
        "xournal-rpc.service")
# Git sources are selected by release tag rather than a forge-specific source archive.
sha256sums=('SKIP'
            '943b6dd87c2afe44cb3f34a5b9f56de583d30137ff300ca672078b06bfa5fba4')

prepare() {
  cd "xournalpp-discord-rpc"
  cargo fetch --locked
}

build() {
  cd "xournalpp-discord-rpc"
  cargo build --release --frozen
}

package() {
  cd "xournalpp-discord-rpc"
  install -Dm755 target/release/xournal-rpc "$pkgdir/usr/bin/xournal-rpc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/xournal-rpc.service" \
    "$pkgdir/usr/lib/systemd/user/xournal-rpc.service"
}
