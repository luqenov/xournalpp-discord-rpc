[Unit]
Description=Discord Rich Presence for Xournal++
Documentation=https://github.com/luqenov/xournalpp-discord-rpc
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/xournal-rpc
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
